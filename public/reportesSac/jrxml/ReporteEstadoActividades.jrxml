	<variable name="SumaNivel2" class="java.math.BigDecimal" resetType="Group" resetGroup="GroupNivel1" calculation="Sum">
		<variableExpression><![CDATA[($F{Nivel}.intValue() == 2 
    ? $F{SaldoFinal} 
    : java.math.BigDecimal.ZERO)]]></variableExpression>
	</variable>
	<variable name="CuentaNivel1" class="java.lang.String">
		<variableExpression><![CDATA[$F{Codigo_cuenta}.substring(
    0, 
    $F{Codigo_cuenta}.indexOf(".") > 0 
       ? $F{Codigo_cuenta}.indexOf(".") 
       : $F{Codigo_cuenta}.length()
)]]></variableExpression>
	</variable>
	<variable name="Total" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$V{SumaGrupo4}.subtract($V{SumaGrupo5})]]></variableExpression>
	</variable>
	<variable name="SumaGrupo4" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[($F{Nivel}.intValue() == 2 && $V{CuentaNivel1}.equals("4"))
    ? $F{SaldoFinal}
    : java.math.BigDecimal.ZERO]]></variableExpression>
	</variable>
	<variable name="SumaGrupo5" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[($F{Nivel}.intValue() == 2 && $V{CuentaNivel1}.equals("5"))
    ? $F{SaldoFinal}
    : java.math.BigDecimal.ZERO]]></variableExpression>
	</variable>
