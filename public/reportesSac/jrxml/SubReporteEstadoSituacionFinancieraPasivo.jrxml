	<variable name="SumaNivel2" class="java.math.BigDecimal" resetType="Group" resetGroup="GroupNivel2" calculation="Sum">
		<variableExpression><![CDATA[($F{Nivel}.intValue() == 3 
    ? $F{SaldoFinal} 
    : java.math.BigDecimal.ZERO)]]></variableExpression>
	</variable>
	<variable name="CuentaNivel2" class="java.lang.String">
		<variableExpression><![CDATA[$F{Codigo_cuenta}.substring(
    0,
    $F{Codigo_cuenta}.indexOf(".", $F{Codigo_cuenta}.indexOf(".") + 1) > 0
        ? $F{Codigo_cuenta}.indexOf(".", $F{Codigo_cuenta}.indexOf(".") + 1)
        : $F{Codigo_cuenta}.length()
)]]></variableExpression>
	</variable>
